---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import {
  ArrowUpRight,
  BookOpen,
  BriefcaseBusiness,
  CodeXml,
  FileText,
  GraduationCap,
  Mail,
  MapPin,
  Phone,
} from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import headshot from "../assets/headshot.png";
import qdtLogicTree from "../assets/research/qdt-logictree.png";
import emadFramework from "../assets/research/emad-framework.png";
import med3dFramework from "../assets/research/med3d-framework.png";
import adReasoningFramework from "../assets/research/adreason-framework.png";

type ResearchItem = {
  title: string;
  venue: string;
  caption: string;
  brief: string;
  role: string;
  details: Array<{ label: string; content: string }>;
  tags: string[];
  image: ImageMetadata;
  imageAlt?: string;
  links?: Array<{ label: string; href: string }>;
};

const research: ResearchItem[] = [
  {
    title: "QDT",
    venue: "MICCAI 2026",
    caption: "第一作者 · 已录用",
    brief: "将医学图像预测拆解为按临床规则串联的二元问题，使最终类别由可审计的问答路径确定，同时用知识蒸馏补偿逻辑约束带来的性能损失。",
    role: "第一作者；完成从问题定义、方法实现到三套数据集实验与论文写作的完整研究",
    image: qdtLogicTree,
    imageAlt: "QDT 在压疮分期任务中的问题驱动决策树与可视化推理路径",
    details: [
      {
        label: "研究问题",
        content: "黑盒模型无法给出可核验的决策过程，传统概念瓶颈模型又以扁平概念代替临床诊断中连续、条件化的判断逻辑，通常需要在准确率和可解释性之间取舍。",
      },
      {
        label: "方法设计",
        content: "QDT 使用临床定义的子问题、注意力特征融合和确定性逻辑树生成诊断路径；训练时先获得高容量教师模型，再从主任务与子任务输出分布、空间注意力两个层面向逻辑约束学生模型蒸馏。",
      },
      {
        label: "数据与验证",
        content: "在 2,292 张压疮图像、25,331 张 ISIC-2019 图像和 5,240 张 MILK10k 图像上验证，覆盖 6、8、10 类诊断任务，并在 ResNet、VGG、DenseNet 和 ViT 等骨干上检验通用性。",
      },
      {
        label: "量化结果",
        content: "ResNet50-QDT 在 ISIC-2019 上达到 84.18% Accuracy，超过 CBM 的 80.97% 和 DCR 的 72.21%；Macro-F1 较原始 ResNet50 提升 5.21 个百分点。学生模型与教师模型的性能差距通常小于 1 个百分点，同时保留确定性问题路径。",
      },
    ],
    tags: ["Decision Tree", "Distillation", "Medical AI"],
  },
  {
    title: "EMAD",
    venue: "CVPR 2026",
    caption: "第二作者 · 已录用",
    brief: "为阿尔茨海默病生成结构化诊断报告，并把报告句子逐级关联到临床证据字段和 3D 脑区，使诊断结论具备可检查的证据链。",
    role: "第二作者；参与证据驱动的 3D 医学多模态诊断、Grounding 与可验证强化学习研究",
    image: emadFramework,
    imageAlt: "EMAD 证据驱动多模态诊断框架图",
    details: [
      {
        label: "研究问题",
        content: "多模态医学模型通常只输出标签或风险分数；即使生成报告，也很少说明每个判断来自哪项临床测量，以及影像证据位于 3D MRI 的哪个解剖区域。",
      },
      {
        label: "方法设计",
        content: "提出 Sentence-Evidence-Anatomy 分层 Grounding，将报告句子先检索到临床证据，再以证据为条件定位 3D MRI 脑区；GTX-Distill 用少量密集标注教师向生成报告上的学生迁移 Grounding，Executable-Rule GRPO 则约束格式、NIA-AA 一致性和推理-诊断蕴含关系。",
      },
      {
        label: "数据与任务",
        content: "基于 ADNI 与 AIBL 构建 AD-MultiSense，包含 2,619 名受试者的 10,378 个多模态样本，联合 3D sMRI、人口统计、病史、认知、实验室、遗传和生物标志物信息，评估二分类、三分类、报告生成与两级 Grounding。",
      },
      {
        label: "量化结果",
        content: "CN/CI 与 CN/MCI 任务分别达到 93.33% 和 92.82% Accuracy，CN/MCI/AD 三分类达到 89.4% Accuracy、87.8% Macro-F1。SEA + GTX-Distill 的句子-证据 R@3 达 0.84，证据条件脑区分割 Dice 从 0.76 提升至 0.82；完整规则奖励将格式有效率、NIA-AA 一致性和推理蕴含分别提升至 99.1%、90.8% 和 87.6%。",
      },
    ],
    tags: ["Grounding", "RLVR", "Multimodal", "3D MRI"],
    links: [{ label: "论文", href: "https://arxiv.org/abs/2602.19178" }],
  },
  {
    title: "Med3DInsight",
    venue: "IEEE JBHI · 2026",
    caption: "第二作者 · 已发表",
    brief: "利用 2D 多模态大模型生成的切片语义监督预训练 3D 医学图像编码器，同时保留疾病语义和精细解剖结构，服务分割与分类任务。",
    role: "第二作者；参与 2D 多模态知识向 3D 医学视觉表征迁移的框架研究与实验验证",
    image: med3dFramework,
    imageAlt: "Med3DInsight 三维医学图像预训练框架图",
    details: [
      {
        label: "研究问题",
        content: "大规模 3D 医学图像-文本配对数据稀缺；直接使用 2D 视觉语言模型会丢失体数据的平面与切片位置，还会受到自动生成描述噪声和 2D/3D 表征错配影响。",
      },
      {
        label: "方法设计",
        content: "Plane-Slice-Aware Transformer 通过可学习查询与平面-切片位置编码连接 3D 体特征和 2D 图文空间；mini-batch Partial Optimal Transport 只匹配可靠的跨模态内容，体数据重建分支保留低层结构细节。",
      },
      {
        label: "实验范围",
        content: "在 8 个 3D 分割数据集和 2 个疾病分类数据集上评估，覆盖 CT、MRI、19 类器官或肿瘤，以及阿尔茨海默病与帕金森病识别，并测试不同骨干、视觉语言模型、切片采样和低数据微调设置。",
      },
      {
        label: "量化结果",
        content: "在 8 个分割数据集上，平均 Dice 较最佳自监督基线提升超过 1 个百分点，平均 HD95 降低 0.7 mm；加入平面-切片位置编码后，OASIS1 平均 Dice 再提升 0.82 个百分点。结果表明无需人工 3D 文本标注，也能把 2D 多模态语义稳定迁移到 3D 下游任务。",
      },
    ],
    tags: ["3D Vision", "MLLM", "Optimal Transport", "Pretraining"],
    links: [{ label: "论文", href: "https://doi.org/10.1109/JBHI.2025.3609739" }],
  },
  {
    title: "AD-Reasoning",
    venue: "ICME 2026",
    caption: "第三作者",
    brief: "联合结构 MRI 与六类临床信息生成阿尔茨海默病分期理由，使用 NIA-AA 规则和可验证奖励约束证据覆盖、输出结构与最终诊断。",
    role: "第三作者；参与多模态临床推理数据、指南约束与强化学习后训练研究",
    image: adReasoningFramework,
    imageAlt: "AD-Reasoning 多模态指南推理框架图",
    details: [
      {
        label: "研究问题",
        content: "阿尔茨海默病诊断依赖影像、认知、遗传和体液标志物等异构证据，常规模型难以说明各模态如何共同支持结论，也无法稳定遵循临床分期标准。",
      },
      {
        label: "方法设计",
        content: "以 3D ViT 和 Longformer 编码结构 MRI 与临床文本，通过双向跨模态融合完成预训练和监督微调；随后采用 GRPO，并组合格式、NIA-AA 诊断和自然语言蕴含奖励，优化结构化 Reasoning/Diagnosis/Confidence 输出。",
      },
      {
        label: "数据与训练",
        content: "AD-MultiSense 汇集 2,619 名受试者的 10,378 个访视样本，覆盖 sMRI 与人口统计、病史、认知、实验室、遗传、生物标志物六类临床信息；采用 PT、SFT、RFT 三阶段训练并按受试者划分训练、验证和测试集。",
      },
      {
        label: "量化结果",
        content: "CN/CI 任务达到 93.33% Accuracy、91.83% AUC，CN/MCI 任务达到 92.82% Accuracy、90.09% AUC；移除预训练或强化学习后处理均造成明显下降。多模态输入优于单独影像或临床数据，验证了跨模态融合和指南奖励的作用。",
      },
    ],
    tags: ["GRPO", "Guideline Reasoning", "Multimodal", "Evaluation"],
    links: [{ label: "论文", href: "https://arxiv.org/abs/2603.24059" }],
  },
];

const publications = [
  {
    venue: "MICCAI 2026",
    title: "Question-Driven Decision Tree via Knowledge Distillation for Interpretable Prediction",
    role: "第一作者 · 已录用",
  },
  {
    venue: "CVPR 2026",
    title: "EMAD: Evidence-Centric Grounded Multimodal Diagnosis for Alzheimer's Disease",
    role: "第二作者 · 已录用",
    href: "https://arxiv.org/abs/2602.19178",
  },
  {
    venue: "IEEE JBHI 2026",
    title: "Enhancing 3D Medical Image Understanding with Pretraining Aided by 2D Multimodal Large Language Models",
    role: "第二作者 · 已发表",
    href: "https://doi.org/10.1109/JBHI.2025.3609739",
  },
  {
    venue: "ICME 2026",
    title: "AD-Reasoning: Multimodal Guideline-Guided Reasoning for Alzheimer's Disease Diagnosis",
    role: "第三作者",
    href: "https://arxiv.org/abs/2603.24059",
  },
];
---

<BaseLayout
  title="姚宣骋｜大模型后训练与 Agent 算法"
  description="聚焦大模型后训练、Agentic RL 与多模态推理，拥有电商仲裁模型上线、Skill 自迭代 Agent 与多模态主动取证 RL 实践。"
>
  <div class="resume-page">
    <header class="resume-header" id="top">
      <div class="header-identity">
        <p class="header-eyebrow">POST-TRAINING · AGENTIC RL · MULTIMODAL AI</p>
        <h1>姚宣骋</h1>
        <p class="header-name-en">XUANCHENG YAO</p>
        <p class="header-title">上海交通大学 · 计算机科学与技术硕士 · 2027 届</p>
        <p class="header-focus">大模型后训练 / Agentic RL / Agent 系统 / 模型评测</p>
      </div>

      <div class="header-contact" aria-label="联系方式">
        <div class="icon-links no-print">
          <a class="icon-button" href="mailto:2212582443@sjtu.edu.cn" aria-label="发送邮件" title="发送邮件">
            <Mail size={21} stroke-width={1.8} />
          </a>
          <a class="icon-button" href="tel:18757212591" aria-label="拨打电话" title="拨打电话">
            <Phone size={20} stroke-width={1.8} />
          </a>
          <a class="icon-button" href="https://github.com/2212582443" target="_blank" rel="noreferrer" aria-label="查看 GitHub" title="GitHub">
            <CodeXml size={21} stroke-width={1.8} />
          </a>
          <a class="icon-button" href="/resume-zh.pdf" target="_blank" aria-label="查看中文简历" title="中文简历 PDF">
            <FileText size={20} stroke-width={1.8} />
          </a>
        </div>
        <div class="contact-lines">
          <p><span>邮箱</span><a href="mailto:2212582443@sjtu.edu.cn">2212582443@sjtu.edu.cn</a></p>
          <p><span>手机</span><a href="tel:18757212591">187 5721 2591</a></p>
          <p><span>GitHub</span><a href="https://github.com/2212582443" target="_blank" rel="noreferrer">github.com/2212582443</a></p>
          <p><span>意向城市</span>上海 / 杭州</p>
        </div>
      </div>
    </header>

    <main id="main">
      <section class="resume-section intro-section" aria-labelledby="about-title">
        <div class="section-title">
          <span id="about-title">个人简介 <small>ABOUT</small></span>
        </div>
        <div class="intro-grid">
          <div class="profile-photo-wrap">
            <Image
              class="profile-photo"
              src={headshot}
              alt="姚宣骋个人照片"
              widths={[320, 480]}
              sizes="(max-width: 700px) 154px, 190px"
              format="webp"
              quality={88}
              loading="eager"
            />
          </div>
          <div class="intro-copy">
            <p class="intro-lead">
              聚焦大模型后训练、多模态推理与 Agent 系统，能够将复杂业务规则拆解为可训练、可评测、可上线的算法系统。
              在字节跳动电商售后仲裁方向独立负责方案模型 SFT + GRPO 端到端训练，主导判责多 Agent、Skill 自迭代评测与主动取证 RL 链路。
            </p>
            <p>
              围绕“证据获取—经验复用—策略学习”打通两条技术闭环：一条用分侧并发推理、全量 Trace 和回归评测实现 Skill 快速迭代；
              另一条基于 verl、Ray 与 vLLM 实现多轮 ReAct、离线工具采样与多模态 RL，再通过 Dynamic Skill 让模型学会按需选择经验。
            </p>
            <p>
              在医疗 AI 方向，以第一作者完成 MICCAI 录用论文 QDT，以第二作者参与 CVPR 与 IEEE JBHI 工作，并以第三作者参与 ICME 工作，
              覆盖可解释决策树、3D 视觉语言预训练、证据 Grounding 和 RLVR。技术工作强调可训练、可评测和可部署，适合大模型算法、Agent 应用算法与模型评测岗位。
            </p>
            <div class="keyword-list" aria-label="核心技术方向">
              <span>大模型后训练</span>
              <span>Agentic RL</span>
              <span>Agent 系统</span>
              <span>模型评测</span>
              <span>可信医疗 AI</span>
            </div>
            <div class="intro-meta">
              <span><BriefcaseBusiness size={16} /> 求职方向：AI 算法 / 应用研发</span>
              <span><MapPin size={16} /> 上海 / 杭州</span>
            </div>
          </div>
        </div>
      </section>

      <section class="resume-section" aria-labelledby="experience-title">
        <div class="section-title">
          <span id="experience-title">实习经历 <small>EXPERIENCE</small></span>
        </div>
        <article class="resume-entry">
          <div class="entry-details">
            <BriefcaseBusiness class="entry-icon" size={21} stroke-width={1.7} />
            <h3>字节跳动</h3>
            <p class="entry-subtitle">算法实习生</p>
            <p class="entry-caption">2026.04 - 2026.08</p>
            <p class="entry-caption">Data · 中国交易与广告 · 电商 · 业务策略与技术 · 智能对话</p>
          </div>
          <div class="entry-content">
            <p class="entry-quote">独立交付仲裁方案模型后训练，主导判责 Agent 与 Agentic RL 两条技术主线，并将 Skill 从工程注入推进为可学习的策略动作。</p>
            <p class="experience-overview">
              将一审仲裁拆分为“支持哪一方”的判责任务和“是否仅退款、退款比例”的方案任务。
              方案模型完成 SFT + GRPO 训练并支撑 V2 上线；判责方向建立“API + Skill 快速验证—开源模型 Agentic RL 能力内化—Dynamic Skill 主动选择经验”的完整技术路线。
            </p>

            <div class="experience-projects">
              <section class="experience-project">
                <div class="experience-project-heading">
                  <span>01</span>
                  <h4>仲裁方案模型训练与上线</h4>
                </div>
                <p>
                  在判责结果支持用户后，进一步预测退货退款或仅退款及其比例。独立负责数据构造、SFT 冷启动、GRPO/DAPO 训练与指标交付，并完成 Critic + Rethink 链路的模型侧适配，支撑方案模型 V2 上线。
                </p>
                <ul>
                  <li>建立“线上模型初标、强模型二次打标、分歧样本人工精标、数据筛选”流水线，构建 5k SFT 冷启动数据、10k RL 训练数据和 9k 测试集。</li>
                  <li>围绕答案组织顺序与 SFT 冷启动开展四组对照。选定配置在 9k 测试集上仅退款判断 Accuracy 为 93.55%、退款比例 Accuracy 为 82.80%；同一答案顺序下，仅退款判断较纯 GRPO 提升 1.07 个百分点。</li>
                  <li>纯 GRPO 配置的比例准确率最高为 85.27%，但仅退款判断略低；最终按“先判准退款类型、再优化比例”的业务优先级选择 SFT + GRPO 配方。</li>
                  <li>作为模型训练核心执行者支撑团队 V2 系统实现 98% 机审覆盖率；首答正确率 91.5%，经 Critic + Rethink 后达到 98.1%。</li>
                  <li>协商期推全后，团队系统带动支持用户执行成功量 +6.5k 单，支持用户覆盖率提升 8.6 个百分点（39.6% → 48.2%）。</li>
                </ul>
              </section>

              <section class="experience-project">
                <div class="experience-project-heading">
                  <span>02</span>
                  <h4>判责 Skill 自迭代 Agent 与评测闭环</h4>
                </div>
                <p>
                  面向规则变化和新错误案例，搭建不更新模型参数的判责 Agent。买家、商家举证 Agent 并发读取各自证据，
                  再由 Merge Agent 汇总结论；职责隔离既减少跨侧干扰，也让错误能够归因到具体一侧或最终汇总环节。
                </p>
                <ul>
                  <li>主导三 Agent 架构与 Runtime Skill Loader，按“细粒度问题、买卖家侧、工具或决策阶段”精确加载 Skill；不跨侧注入、不累积无关片段，通过配置切换版本并支持回滚。</li>
                  <li>记录每轮工具结果、实际加载的 Skill 和决策轨迹，提供 JSON 与 HTML 复盘视图；建立小样本联调、全量评测和错误迁移分析流程，同时跟踪已修复、持续错误与新增退化案例。</li>
                  <li>在固定 804 条评测集上，无 Skill、Skill v1、Skill v2 的 Accuracy 分别为 78.23%、87.06%、90.30%。两轮累计提升 12.07 个百分点，错误案例由 175 条降至 78 条，买卖家两侧 Precision/Recall 同步提升。</li>
                  <li>主导 Agent 架构、Skill 加载、轨迹可观测、评测脚本及协作接口，与 Skill 归因/生成侧协同构建可复现、可回滚的能力迭代闭环。</li>
                </ul>
              </section>

              <section class="experience-project">
                <div class="experience-project-heading">
                  <span>03</span>
                  <h4>判责 Agentic RL 与主动取证</h4>
                </div>
                <p>
                  基于 verl、Ray 与 vLLM 搭建 Qwen3-VL-30B-A3B 的多模态 Agentic RL 链路，
                  将长上下文静态判定改为“识别证据缺口、按需调用工具、更新状态、输出判责结论”的多轮 ReAct 策略。
                </p>
                <ul>
                  <li>接入聊天、售后举证、物流、OCR 和高清看图 5 类工具，显式维护当前判断、关键依据和证据缺口；仅在需要时加载图片，并约束同一证据工具不重复调用。</li>
                  <li>实现离线工具缓存：4 类非确定性远程工具各采样 3 轮，物流工具本地采样 1 轮；Rollout 从缓存中采样 Observation，减少远程调用耗时与随机失败对训练的干扰。</li>
                  <li>以最终判责正确性为主要奖励，结合工具调用辅助信号和执行约束，串联 GRPO/DAPO、异步 Rollout、评估与轨迹导出，并完成推理服务和工具服务联调。</li>
                  <li>在 906 条离线验证样本中正确判责 831 条，Accuracy 为 91.7%；平均工具调用 2.6 轮，通用模型零样本对照为 3.6 轮，在控制调用开销的同时完成主动取证与判责。</li>
                  <li>完成 906 条 GT 验证、训练链路联调与完整轨迹导出，将该版本沉淀为无 Skill RL 基线及 Dynamic Skill 的可复用训练基座。</li>
                </ul>
              </section>

              <section class="experience-project">
                <div class="experience-project-heading">
                  <span>04</span>
                  <h4>Dynamic Skill：让模型学习选择经验</h4>
                </div>
                <p>
                  在 Agentic RL 基础上，把工具结果后的 Skill 硬注入改为模型可选择的动作：先展示候选经验的简要说明，
                  再由模型选择加载具体片段或显式跳过，使经验使用成为策略学习的一部分。
                </p>
                <ul>
                  <li>区分初始固定的规划、最终判断 Skill 与运行时的工具阅读 Skill；设计“工具返回、候选摘要、选择编号、加载正文”的交互流程，每个工具结果只允许选择一次，避免反复加载和上下文膨胀。</li>
                  <li>主导加载机制、Agent Loop 与训练评估链路改造，处理图片特征与 Token 不匹配、长上下文显存不足、非数值轨迹参与指标聚合等问题，分离可观测数据与数值评测。</li>
                  <li>在相同 Qwen3-VL-4B 模型与数据口径下，Dynamic Skill 在 50、100 Step 验证节点均优于无 Skill 基线，验证“模型主动选择经验”的机制价值。</li>
                  <li>将 4B 机制验证推进至 30B 规模训练适配，系统解决 OOM、candidate_count=0、图像特征与 Token 不匹配、验证聚合崩溃等 8 类关键工程问题。</li>
                </ul>
              </section>
