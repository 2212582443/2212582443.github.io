---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import {
  ArrowUpRight,
  BookOpen,
  BriefcaseBusiness,
  CodeXml,
  FileText,
  GraduationCap,
  Mail,
  MapPin,
  Phone,
} from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import headshot from "../assets/headshot.png";
import qdtLogicTree from "../assets/research/qdt-logictree.png";
import emadFramework from "../assets/research/emad-framework.png";
import med3dFramework from "../assets/research/med3d-framework.png";
import adReasoningFramework from "../assets/research/adreason-framework.png";

type ResearchItem = {
  title: string;
  venue: string;
  caption: string;
  brief: string;
  highlights: string[];
  id: string;
  role: string;
  details: Array<{ label: string; content: string }>;
  tags: string[];
  image: ImageMetadata;
  imageAlt?: string;
  links?: Array<{ label: string; href: string }>;
};

const research: ResearchItem[] = [
  {
    title: "QDT",
    id: "qdt",
    venue: "MICCAI 2026",
    caption: "第一作者 · 已发表",
    brief: "让分类模型给出可以逐步核验的判断依据：把医学诊断拆成连续的二元问题，以确定性逻辑树生成结论，再用多层知识蒸馏保留模型的识别能力。",
    highlights: ["ISIC-2019 准确率 84.18%", "Macro-F1 +5.21 个百分点", "3 套数据集 · 4 类骨干"],
    role: "第一作者；完成从问题定义、方法实现到三套数据集实验与论文写作的完整研究",
    image: qdtLogicTree,
    imageAlt: "QDT 在压疮分期任务中的问题驱动决策树与可视化推理路径",
    details: [
      {
        label: "研究问题",
        content: "黑盒模型无法给出可核验的决策过程，传统概念瓶颈模型又以扁平概念代替临床诊断中连续、条件化的判断逻辑，通常需要在准确率和可解释性之间取舍。",
      },
      {
        label: "方法设计",
        content: "把临床诊断标准转换为有先后关系的二元子问题，由子任务预测和确定性逻辑树共同决定类别，而非事后生成一段解释。先训练高容量教师，再对主任务分布、子问题分布与空间注意力进行蒸馏，让学生在遵守逻辑结构的同时学习教师的视觉判别能力；推理时只需输入图像，无需人工回答子问题。",
      },
      {
        label: "数据与验证",
        content: "在压疮分期、ISIC-2019 与 MILK10k 三套数据集上验证，覆盖 6、8、10 类任务。通过 ResNet、VGG、DenseNet、ViT 多骨干实验，以及子任务监督、注意力融合和蒸馏消融，检验收益是否依赖特定架构。",
      },
      {
        label: "量化结果",
        content: "ResNet50-QDT 在 ISIC-2019 上达到 84.18% Accuracy，超过 CBM 的 80.97% 和 DCR 的 72.21%；Macro-F1 较原始 ResNet50 提升 5.21 个百分点。学生模型与教师模型的性能差距通常小于 1 个百分点，同时保留确定性问题路径。",
      },
    ],
    tags: ["Decision Tree", "Distillation", "Medical AI"],
    links: [{ label: "Springer 正式论文", href: "https://link.springer.com/chapter/10.1007/978-3-032-38079-1_43" }],
  },
  {
    title: "EMAD",
    id: "emad",
    venue: "CVPR 2026",
    caption: "第二作者 · 已录用",
    brief: "把多模态报告中的每个判断连接到具体证据：联合 3D MRI 与临床信息生成诊断报告，进一步定位支持结论的临床字段和解剖区域，并用可验证奖励提升报告一致性。",
    highlights: ["CN/CI 准确率 93.33%", "证据检索 R@3 0.84", "脑区定位 Dice 0.76 → 0.82"],
    role: "第二作者；参与证据驱动的 3D 医学多模态诊断、Grounding 与可验证强化学习研究",
    image: emadFramework,
    imageAlt: "EMAD 证据驱动多模态诊断框架图",
    details: [
      {
        label: "研究问题",
        content: "多模态医学模型通常只输出标签或风险分数；即使生成报告，也很少说明每个判断来自哪项临床测量，以及影像证据位于 3D MRI 的哪个解剖区域。",
      },
      {
        label: "方法设计",
        content: "采用 Sentence-Evidence-Anatomy 分层定位：先将报告句子对应到临床证据，再以证据为条件定位 3D MRI 脑区。通过 GTX-Distill，把少量密集标注训练出的教师定位能力迁移到生成报告的学生模型；再以 GRPO 联合优化报告格式、NIA-AA 指南一致性和推理与诊断的逻辑一致性。",
      },
      {
        label: "数据与任务",
        content: "基于 ADNI 与 AIBL 构建 AD-MultiSense，包含 2,619 名受试者的 10,378 个多模态样本，联合 3D sMRI、人口统计、病史、认知、实验室、遗传和生物标志物信息，评估二分类、三分类、报告生成与两级 Grounding。",
      },
      {
        label: "量化结果",
        content: "CN/CI 与 CN/MCI 任务分别达到 93.33% 和 92.82% Accuracy，CN/MCI/AD 三分类达到 89.4% Accuracy、87.8% Macro-F1。SEA + GTX-Distill 的句子-证据 R@3 达 0.84，证据条件脑区分割 Dice 从 0.76 提升至 0.82；完整规则奖励将格式有效率、NIA-AA 一致性和推理蕴含分别提升至 99.1%、90.8% 和 87.6%。",
      },
    ],
    tags: ["Grounding", "RLVR", "Multimodal", "3D MRI"],
    links: [{ label: "论文", href: "https://arxiv.org/abs/2602.19178" }],
  },
  {
    title: "Med3DInsight",
    id: "med3dinsight",
    venue: "IEEE JBHI · 2026",
    caption: "第二作者 · 已发表",
    brief: "在缺少 3D 图文标注的条件下，把 2D 多模态大模型的语义知识迁移到 3D 编码器；通过空间位置建模与可靠样本对齐，兼顾疾病语义和分割所需的结构细节。",
    highlights: ["8 个分割数据集 · 2 个分类任务", "平均 Dice 提升超过 1 个百分点", "平均 HD95 降低 0.7 mm"],
    role: "第二作者；参与 2D 多模态知识向 3D 医学视觉表征迁移的框架研究与实验验证",
    image: med3dFramework,
    imageAlt: "Med3DInsight 三维医学图像预训练框架图",
    details: [
      {
        label: "研究问题",
        content: "大规模 3D 医学图像-文本配对数据稀缺；直接使用 2D 视觉语言模型会丢失体数据的平面与切片位置，还会受到自动生成描述噪声和 2D/3D 表征错配影响。",
      },
      {
        label: "方法设计",
        content: "Plane-Slice Attention Transformer 通过可学习查询和平面／切片位置编码，将 3D 体特征对齐到 2D 图文空间。针对自动描述中的噪声，采用 mini-batch Partial Optimal Transport 选择可靠的跨模态匹配；同时保留体数据重建任务，避免语义对齐损害精细解剖信息。",
      },
      {
        label: "实验范围",
        content: "在 8 个 3D 分割数据集和 2 个疾病分类数据集上评估，覆盖 CT、MRI、19 类器官或肿瘤，以及阿尔茨海默病与帕金森病识别，并测试不同骨干、视觉语言模型、切片采样和低数据微调设置。",
      },
      {
        label: "量化结果",
        content: "在 8 个分割数据集上，平均 Dice 较最佳自监督基线提升超过 1 个百分点，平均 HD95 降低 0.7 mm；加入平面-切片位置编码后，OASIS1 平均 Dice 再提升 0.82 个百分点。结果表明无需人工 3D 文本标注，也能把 2D 多模态语义稳定迁移到 3D 下游任务。",
      },
    ],
    tags: ["3D Vision", "MLLM", "Optimal Transport", "Pretraining"],
    links: [{ label: "论文", href: "https://doi.org/10.1109/JBHI.2025.3609739" }],
  },
  {
    title: "AD-Reasoning",
    id: "ad-reasoning",
    venue: "ICME 2026",
    caption: "第三作者",
    brief: "把临床指南转成模型可学习的训练信号：融合 3D MRI 与六类临床信息，通过预训练、SFT 和 GRPO，让诊断输出同时包含依据、结论与置信度。",
    highlights: ["CN/MCI 准确率 92.82%", "影像 + 6 类临床信息", "PT → SFT → GRPO"],
    role: "第三作者；参与多模态临床推理数据、指南约束与强化学习后训练研究",
    image: adReasoningFramework,
    imageAlt: "AD-Reasoning 多模态指南推理框架图",
    details: [
      {
        label: "研究问题",
        content: "阿尔茨海默病诊断依赖影像、认知、遗传和体液标志物等异构证据，常规模型难以说明各模态如何共同支持结论，也无法稳定遵循临床分期标准。",
      },
      {
        label: "方法设计",
        content: "以 3D ViT 和 Longformer 编码结构 MRI 与临床文本，通过双向跨模态融合完成预训练和监督微调；随后采用 GRPO，并组合格式、NIA-AA 诊断和自然语言蕴含奖励，优化结构化 Reasoning/Diagnosis/Confidence 输出。",
      },
      {
        label: "数据与训练",
        content: "AD-MultiSense 汇集 2,619 名受试者的 10,378 个访视样本，覆盖 sMRI 与人口统计、病史、认知、实验室、遗传、生物标志物六类临床信息；采用 PT、SFT、RFT 三阶段训练并按受试者划分训练、验证和测试集。",
      },
      {
        label: "量化结果",
        content: "CN/CI 任务达到 93.33% Accuracy、91.83% AUC，CN/MCI 任务达到 92.82% Accuracy、90.09% AUC；移除预训练或强化学习后处理均造成明显下降。多模态输入优于单独影像或临床数据，验证了跨模态融合和指南奖励的作用。",
      },
    ],
    tags: ["GRPO", "Guideline Reasoning", "Multimodal", "Evaluation"],
    links: [{ label: "论文", href: "https://arxiv.org/abs/2603.24059" }],
  },
];

const publications = [
  {
    venue: "MICCAI 2026",
    title: "Question-Driven Decision Tree via Knowledge Distillation for Interpretable Prediction",
    role: "第一作者 · 已发表",
    href: "https://link.springer.com/chapter/10.1007/978-3-032-38079-1_43",
  },
  {
    venue: "CVPR 2026",
    title: "EMAD: Evidence-Centric Grounded Multimodal Diagnosis for Alzheimer's Disease",
    role: "第二作者 · 已录用",
    href: "https://arxiv.org/abs/2602.19178",
  },
  {
    venue: "IEEE JBHI 2026",
    title: "Enhancing 3D Medical Image Understanding with Pretraining Aided by 2D Multimodal Large Language Models",
    role: "第二作者 · 已发表",
    href: "https://doi.org/10.1109/JBHI.2025.3609739",
  },
  {
    venue: "ICME 2026",
    title: "AD-Reasoning: Multimodal Guideline-Guided Reasoning for Alzheimer's Disease Diagnosis",
    role: "第三作者",
    href: "https://arxiv.org/abs/2603.24059",
  },
];
