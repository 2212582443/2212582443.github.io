---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import {
  ArrowUpRight,
  BookOpen,
  BriefcaseBusiness,
  CodeXml,
  FileText,
  GraduationCap,
  Mail,
  MapPin,
  Phone,
} from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import headshot from "../assets/headshot.png";
import qdtLogicTree from "../assets/research/qdt-logictree.png";
import emadFramework from "../assets/research/emad-framework.png";
import med3dFramework from "../assets/research/med3d-framework.png";
import adReasoningFramework from "../assets/research/adreason-framework.png";

type ResearchItem = {
  title: string;
  venue: string;
  caption: string;
  brief: string;
  role: string;
  details: Array<{ label: string; content: string }>;
  tags: string[];
  image: ImageMetadata;
  imageAlt?: string;
  links?: Array<{ label: string; href: string }>;
};

const research: ResearchItem[] = [
  {
    title: "QDT",
    venue: "MICCAI 2026",
    caption: "第一作者 · 已录用",
    brief: "把医学图像分类改写为一组有临床含义的连续问答，使模型不仅给出类别，还能暴露从图像证据到最终判断的完整决策路径。",
    role: "作为第一作者，主导问题定义、框架设计、代码实现、实验验证与论文写作",
    image: qdtLogicTree,
    imageAlt: "QDT 在压疮分期任务中的问题驱动决策树与可视化推理路径",
    details: [
      {
        label: "研究问题",
        content: "传统黑盒分类器难以解释真实决策过程，而概念瓶颈模型通常使用扁平概念，无法表达临床诊断中连续、条件化的判断逻辑。",
      },
      {
        label: "方法设计",
        content: "将诊断规则拆解为临床可核验的二元子问题，并以确定性逻辑树聚合答案；通过注意力特征融合建模子任务间关系，再以输出分布和空间注意力的多层知识蒸馏，缓解逻辑约束带来的性能损失。",
      },
      {
        label: "个人贡献",
        content: "完成 QDT 从研究假设到可复现实验的主体工作，包括任务形式化、教师-学生架构、软路径训练、消融与跨骨干验证，并推动临床规则整理和论文完整表达。",
      },
      {
        label: "结果与意义",
        content: "在压疮分期及两项公开皮肤病变基准上验证框架，逻辑约束学生模型在保持问题级可审计路径的同时，达到接近或超过强黑盒模型的表现。",
      },
    ],
    tags: ["Decision Tree", "Distillation", "Medical AI"],
  },
  {
    title: "EMAD",
    venue: "CVPR 2026",
    caption: "第二作者",
    brief: "让阿尔茨海默病诊断报告中的每一项关键结论都能回指临床字段和 3D 脑区，形成可追溯、可检查的证据链。",
    role: "作为第二作者，负责证据对齐、可验证强化学习及相关实验验证",
    image: emadFramework,
    imageAlt: "EMAD 证据驱动多模态诊断框架图",
    details: [
      {
        label: "研究问题",
        content: "现有多模态医学模型多停留在标签或风险分数层面，即使能生成报告，也缺少句子、临床证据和影像解剖位置之间的显式连接。",
      },
      {
        label: "方法设计",
        content: "提出 Sentence-Evidence-Anatomy 分层对齐，将报告句子先关联到临床证据，再定位到 3D MRI 解剖区域；利用 GTX-Distill 从少量密集标注迁移 grounding 能力，并以可执行规则驱动 GRPO 后训练。",
      },
      {
        label: "个人贡献",
        content: "参与证据对齐与蒸馏模块设计，实现临床格式、指南一致性和推理-结论一致性的可验证奖励，完成强化学习训练与 grounding、诊断和报告质量的系统实验。",
      },
      {
        label: "结果与意义",
        content: "模型能够联合利用 3D 结构 MRI 与临床变量生成结构化诊断报告，并把结论落到具体测量和脑区，为可信医学多模态生成提供可操作的验证接口。",
      },
    ],
    tags: ["Grounding", "RLVR", "Multimodal", "3D MRI"],
    links: [{ label: "论文", href: "https://arxiv.org/abs/2602.19178" }],
  },
  {
    title: "Med3DInsight",
    venue: "IEEE JBHI",
    caption: "第二作者",
    brief: "借助成熟 2D 多模态大模型提供的语义监督，学习同时保留高层语义和低层结构细节的通用 3D 医学图像表征。",
    role: "作为第二作者，负责核心模型实现、训练管线与实验分析",
    image: med3dFramework,
    imageAlt: "Med3DInsight 三维医学图像预训练框架图",
    details: [
      {
        label: "研究问题",
        content: "大规模 3D 医学图像-文本配对数据稀缺，直接套用 2D 视觉语言模型又会忽略体数据的空间方向，并引入切片描述噪声和跨维度错配。",
      },
      {
        label: "方法设计",
        content: "用 Plane-Slice-Aware Transformer 将 3D 体特征投影到带有平面与切片位置的 2D 表征空间；以 Partial Optimal Transport 选择性对齐 3D、切片和文本特征，并结合体数据重建保留细粒度结构。",
      },
      {
        label: "个人贡献",
        content: "完成 PSAT、跨模态对齐和下游微调相关实现，参与多数据集训练、对照实验与消融分析，系统排查 2D 语义迁移到 3D 场景时的空间与噪声问题。",
      },
      {
        label: "结果与意义",
        content: "预训练表示可迁移到 CT 与 MRI 的多器官、肿瘤分割及疾病分类任务，说明无需人工 3D 文本标注也能有效引入多模态语义监督。",
      },
    ],
    tags: ["3D Vision", "MLLM", "Optimal Transport", "Pretraining"],
    links: [
      { label: "论文", href: "https://arxiv.org/abs/2509.09064" },
      { label: "代码", href: "https://github.com/Qybc/Med3DInsight" },
    ],
  },
  {
    title: "AD-Reasoning",
    venue: "ICME 2026",
    caption: "第三作者",
    brief: "融合结构 MRI、认知量表、遗传与生物标志物等异构信息，用临床指南和可验证奖励约束诊断理由与最终结论。",
    role: "作为第三作者，负责数据构建、奖励设计和系统评测",
    image: adReasoningFramework,
    imageAlt: "AD-Reasoning 多模态指南推理框架图",
    details: [
      {
        label: "研究问题",
        content: "阿尔茨海默病诊断需要综合影像、认知、遗传和体液标志物，但常规模型难以解释各模态如何共同支持结论，也缺乏对临床指南的稳定遵循。",
      },
      {
        label: "方法设计",
        content: "构建涵盖结构 MRI 与多类临床字段的诊疗样本，经跨模态预训练和监督微调建立基础能力，再使用 GRPO 结合格式、NIA-AA 指南与推理一致性奖励进行可验证强化学习。",
      },
      {
        label: "个人贡献",
        content: "参与多模态数据清洗与诊疗问答构造，设计和实现指南要素覆盖、证据状态与推理-结论蕴含等奖励规则，并完成生成质量、分类能力和消融实验评测。",
      },
      {
        label: "结果与意义",
        content: "框架能生成结构化的诊断理由、分期结论与置信度，并通过规则验证器检查关键医学证据，为医疗场景中的 RLVR 训练提供了完整案例。",
      },
    ],
    tags: ["GRPO", "Guideline Reasoning", "Multimodal", "Evaluation"],
    links: [{ label: "论文", href: "https://arxiv.org/abs/2603.24059" }],
  },
];

const publications = [
  {
    venue: "MICCAI 2026",
    title: "QDT: Question-Driven Decision Tree for Interpretable Prediction",
    role: "第一作者 · 已录用",
  },
  {
    venue: "CVPR 2026",
    title: "EMAD: Evidence-Centric Grounded Multimodal Diagnosis for Alzheimer's Disease",
    role: "第二作者",
    href: "https://arxiv.org/abs/2602.19178",
  },
  {
    venue: "IEEE JBHI",
    title: "Enhancing 3D Medical Image Understanding with Pretraining Aided by 2D Multimodal Large Language Models",
    role: "第二作者",
    href: "https://arxiv.org/abs/2509.09064",
  },
  {
    venue: "ICME 2026",
    title: "AD-Reasoning: Multimodal Guideline-Guided Reasoning for Alzheimer's Disease Diagnosis",
    role: "第三作者",
    href: "https://arxiv.org/abs/2603.24059",
  },
];
---

<BaseLayout
  title="姚宣骋｜AI 算法与应用研发"
  description="上海交通大学计算机科学与技术硕士，2027 届，关注多模态大模型、Agentic RL、模型评测与可信医疗 AI。"
>
  <div class="resume-page">
    <header class="resume-header" id="top">
      <div class="header-identity">
        <p class="header-eyebrow">AI ALGORITHM · APPLICATION · EVALUATION</p>
        <h1>姚宣骋</h1>
        <p class="header-name-en">XUANCHENG YAO</p>
        <p class="header-title">上海交通大学 · 计算机科学与技术硕士 · 2027 届</p>
        <p class="header-focus">多模态大模型 / Agent 系统 / 模型评测 / 可信医疗 AI</p>
      </div>

      <div class="header-contact" aria-label="联系方式">
        <div class="icon-links no-print">
          <a class="icon-button" href="mailto:2212582443@sjtu.edu.cn" aria-label="发送邮件" title="发送邮件">
            <Mail size={21} stroke-width={1.8} />
          </a>
          <a class="icon-button" href="tel:18757212591" aria-label="拨打电话" title="拨打电话">
            <Phone size={20} stroke-width={1.8} />
          </a>
          <a class="icon-button" href="https://github.com/2212582443" target="_blank" rel="noreferrer" aria-label="查看 GitHub" title="GitHub">
            <CodeXml size={21} stroke-width={1.8} />
          </a>
          <a class="icon-button" href="/resume-zh.pdf" target="_blank" aria-label="查看中文简历" title="中文简历 PDF">
            <FileText size={20} stroke-width={1.8} />
          </a>
        </div>
        <div class="contact-lines">
          <p><span>邮箱</span><a href="mailto:2212582443@sjtu.edu.cn">2212582443@sjtu.edu.cn</a></p>
          <p><span>手机</span><a href="tel:18757212591">187 5721 2591</a></p>
          <p><span>GitHub</span><a href="https://github.com/2212582443" target="_blank" rel="noreferrer">github.com/2212582443</a></p>
          <p><span>意向城市</span>上海 / 杭州</p>
        </div>
      </div>
    </header>

    <main id="main">
      <section class="resume-section intro-section" aria-labelledby="about-title">
        <div class="section-title">
          <span id="about-title">个人简介 <small>ABOUT</small></span>
        </div>
        <div class="intro-grid">
          <div class="profile-photo-wrap">
            <Image
              class="profile-photo"
              src={headshot}
              alt="姚宣骋个人照片"
              widths={[320, 480]}
              sizes="(max-width: 700px) 154px, 190px"
              format="webp"
              quality={88}
              loading="eager"
            />
          </div>
          <div class="intro-copy">
            <p class="intro-lead">
              上海交通大学计算机科学与技术本硕，具备大模型后训练、多工具 Agent、自动评测与医学多模态研究的复合经验。
              曾在字节跳动电商智能对话团队完成售后仲裁大模型的训练、评估与上线，并从零搭建 Agentic RL 训练链路和 Skill 自迭代系统。
            </p>
            <p>
              能够把高噪声、长上下文、多模态的业务问题拆解为可训练、可评估、可部署的技术任务：从数据策略、SFT/GRPO 实验，
              到 ReAct 工具编排、分布式 rollout、离线采样优化和服务化部署，均有完整实践。面对不确定问题时，习惯先建立可靠评测与诊断框架，
              再通过可复现实验确定迭代方向，而不是停留在提示词或单点模型调用层面。
            </p>
            <p>
              科研方面以第一作者完成 MICCAI 2026 录用工作，并参与 CVPR、IEEE JBHI、ICME 等多项研究，覆盖可解释决策树、
              3D 医学视觉语言学习、证据 grounding 与可验证强化学习。适合需要同时理解模型、系统与业务约束的 AI 算法、Agent 应用和模型评测岗位。
            </p>
            <div class="keyword-list" aria-label="核心技术方向">
              <span>多模态大模型</span>
              <span>Agentic RL</span>
              <span>Agent 系统</span>
              <span>模型评测</span>
              <span>可信医疗 AI</span>
            </div>
            <div class="intro-meta">
              <span><BriefcaseBusiness size={16} /> 求职方向：AI 算法 / 应用研发</span>
              <span><MapPin size={16} /> 上海 / 杭州</span>
            </div>
          </div>
        </div>
      </section>

      <section class="resume-section" aria-labelledby="experience-title">
        <div class="section-title">
          <span id="experience-title">实习经历 <small>EXPERIENCE</small></span>
        </div>
        <article class="resume-entry">
          <div class="entry-details">
            <BriefcaseBusiness class="entry-icon" size={21} stroke-width={1.7} />
            <h3>字节跳动</h3>
            <p class="entry-subtitle">多模态大模型算法实习生</p>
            <p class="entry-caption">2026.04 - 2026.08</p>
            <p class="entry-caption">中国交易与广告 · 电商 · 智能对话</p>
          </div>
          <div class="entry-content">
            <p class="entry-quote">独立推进三条技术线，把复杂业务规则转化为可训练、可验证、可上线的大模型与 Agent 系统。</p>
            <p class="experience-overview">
              面向电商售后仲裁中长上下文、多模态证据与复杂 policy 并存的场景，负责从问题定义、数据构造、模型训练、实验分析到部署验证的完整链路。
              工作同时覆盖模型能力提升和系统效率优化，并与运营团队围绕标注规范、badcase 与业务规则持续协作。
            </p>

            <div class="experience-projects">
              <section class="experience-project">
                <div class="experience-project-heading">
                  <span>01</span>
                  <h4>仲裁方案模型训练与上线</h4>
                </div>
                <p>
                  将“是否退款与退款比例”的联合判断从通用模型直接调用升级为业务模型端到端决策。设计 SFT 冷启动与 GRPO 强化学习两阶段方案，
                  基于 EasyR1 完成数据接入、训练、评估和线上部署。
                </p>
                <ul>
                  <li>建立“线上模型初标、强模型复核、分歧样本人工精标、质量筛选”的数据流水线，在有限标注成本下形成数千级冷启动数据和万级强化学习数据。</li>
                  <li>系统比较纯 GRPO、SFT + GRPO 及不同答案组织方式，通过对照与消融确定更稳定的训练配置，并定位 SFT 泛化与 RL 探索之间的权衡。</li>
                  <li>核心判断指标达到九成以上并完成上线；相关准确率与召回率相较原有 zero-shot / critic 方案获得明显提升。</li>
                </ul>
              </section>

              <section class="experience-project">
                <div class="experience-project-heading">
                  <span>02</span>
                  <h4>Agentic RL 训练与部署链路</h4>
                </div>
                <p>
                  针对单个仲裁 case 上下文长、图片多且不同纠纷依赖不同证据的问题，将一次性静态判定改造成 policy 驱动的主动取证 Agent，
                  让模型在多轮循环中决定查什么证据、如何继续推理以及何时给出结论。
                </p>
                <ul>
                  <li>在 verl 上扩展多模态训练链路，串联 Ray 分布式调度、vLLM 异步 rollout、LangGraph 风格 ReAct Loop、自定义 reward 与异常容错。</li>
                  <li>围绕聊天记录、售后举证、物流、商品宣传信息与图像细节设计多类取证工具，统一训练环境和线上推理服务的调用协议。</li>
                  <li>通过 profiling 识别远程工具调用为主要瓶颈，提出多轮预采样与 observation 缓存机制，将训练阶段的不稳定在线调用转为本地查询，显著改善吞吐和可复现性。</li>
                  <li>维护 Agent 推理与工具服务模块，打通训练、离线评估和服务化部署，为后续策略迭代提供可复用基础设施。</li>
                </ul>
              </section>

              <section class="experience-project">
                <div class="experience-project-heading">
                  <span>03</span>
                  <h4>Agent Skill 自迭代与自动评测</h4>
                </div>
                <p>
                  为缩短模型重训练周期，设计不更新参数的轻量迭代路径：从失败案例中归纳稳定错误模式，自动生成结构化 Skill，
                  再通过统一评测判断是否进入版本库。
                </p>
                <ul>
                  <li>实现“badcase 收集、错误归因、Skill 生成、效果验证、版本更新”闭环，将零散提示词调整转化为有基线、有回归测试的系统迭代。</li>
                  <li>在判责场景完成落地与验证，并将方法扩展到方案任务，使 Skill 迭代与 SFT / RL 形成快慢结合的能力提升机制。</li>
                  <li>沉淀技术方案、实验结论和交接材料，使相关链路能够被团队继续维护和复用。</li>
                </ul>
              </section>
            </div>
            <div class="inline-tags" aria-label="实习技术关键词">
              <span>Post-training</span><span>Agentic RL</span><span>Agent System</span><span>Evaluation</span><span>Deployment</span>
            </div>
          </div>
        </article>
      </section>

      <section class="resume-section" aria-labelledby="research-title">
        <div class="section-title">
          <span id="research-title">科研成果 <small>SELECTED RESEARCH</small></span>
        </div>
        <div class="research-list">
          {research.map((item) => (
            <article class="resume-entry research-entry">
              <div class="entry-details">
                <BookOpen class="entry-icon" size={21} stroke-width={1.7} />
                <h3>{item.title}</h3>
                <p class="entry-subtitle">{item.venue}</p>
                <p class="entry-caption">{item.caption}</p>
                {item.links && (
                  <div class="entry-links no-print">
                    {item.links.map((link) => (
                      <a href={link.href} target="_blank" rel="noreferrer">
                        {link.label}<ArrowUpRight size={14} />
                      </a>
                    ))}
                  </div>
                )}
              </div>
              <div class="entry-content research-content">
                <p class="entry-quote">{item.brief}</p>
                <div class="research-visual">
                  <Image
                    src={item.image}
                    alt={item.imageAlt ?? "论文方法框架图"}
                    widths={[720, 1080, 1440]}
                    sizes="(max-width: 760px) 100vw, 760px"
                    format="webp"
                    quality={90}
                    loading="lazy"
                  />
                </div>
                <details class="entry-more">
                  <summary><span>详情</span><span class="details-mark">+</span></summary>
                  <div class="entry-more-content">
                    <p class="research-role">{item.role}</p>
                    <dl class="research-detail-list">
                      {item.details.map((detail) => (
                        <div>
                          <dt>{detail.label}</dt>
                          <dd>{detail.content}</dd>
                        </div>
                      ))}
                    </dl>
                    <div class="inline-tags">{item.tags.map((tag) => <span>{tag}</span>)}</div>
                  </div>
                </details>
              </div>
            </article>
          ))}
